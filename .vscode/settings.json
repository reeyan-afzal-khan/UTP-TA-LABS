{
  // Tinymist is the only Typst extension for this workspace (see .typst-setup/README.md).
  "tinymist.rootPath": "${workspaceFolder}",
  "tinymist.fontPaths": [
    "${workspaceFolder}/.shared/assets/fonts"
  ],
  "tinymist.systemFonts": false,
  "tinymist.exportPdf": "never",
  // The books run to 500 pages. Redrawing the preview on every keystroke keeps it
  // busy; redraw it when the file is saved (Ctrl+S) instead.
  "tinymist.preview.refresh": "onSave",
  "tinymist.preview.partialRendering": true,
  "tinymist.preview.invertColors": "never",
  // The compile indicator changes on every keystroke in a large book.
  "tinymist.compileStatus": "disable",
  "tinymist.formatterMode": "typstyle",
  "[typst]": {
    "editor.wordWrap": "on",
    "editor.defaultFormatter": "myriad-dreamin.tinymist",
    "editor.formatOnSave": false
  },
  "files.watcherExclude": {
    "**/.build/**": true,
    "**/.courses/**": true,
    "**/.courses-srts/**": true,
    "**/.typst-setup/.venv-typst/**": true,
    "**/.all-pdfs/**": true,
    "**/all_datasets/**": true
  },
  "search.exclude": {
    "**/.build/**": true,
    "**/.courses/**": true,
    "**/.courses-srts/**": true,
    "**/.typst-setup/.venv-typst/**": true,
    "**/.shared/packages/**": true,
    "**/.all-pdfs/**": true
  },
  "python-envs.defaultEnvManager": "ms-python.python:conda",
  "python-envs.defaultPackageManager": "ms-python.python:conda"
}
