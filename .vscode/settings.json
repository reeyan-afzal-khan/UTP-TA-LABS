{
  "latex-workshop.latex.recipes": [
    {
      "name": "UTP: full build (references checked)",
      "tools": [
        "utp-latexmk"
      ]
    },
    {
      "name": "UTP: one-pass preview (references may be stale)",
      "tools": [
        "utp-preview"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "utp-latexmk",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "%WORKSPACE_FOLDER%/.latex-setup/Build.ps1",
        "-MainFile",
        "%DOC_EXT%"
      ],
      "cwd": "%DIR%"
    },
    {
      "name": "utp-preview",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "%WORKSPACE_FOLDER%/.latex-setup/Build.ps1",
        "-MainFile",
        "%DOC_EXT%",
        "-Mode",
        "Preview"
      ],
      "cwd": "%DIR%"
    }
  ],
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/.build/%RELATIVE_DIR%",
  "latex-workshop.latex.autoBuild.run": "onFileChange",
  "latex-workshop.latex.autoBuild.interval": 1500,
  "latex-workshop.latex.autoBuild.cleanAndRetry.enabled": false,
  "latex-workshop.latex.autoClean.run": "never",
  "latex-workshop.latex.build.rootfileInStatus": true,
  "latex-workshop.latex.search.rootFiles.include": [
    "*/main.tex"
  ],
  "latex-workshop.latex.search.rootFiles.exclude": [
    "**/.courses/**",
    "**/.engine/**",
    "**/.build/**",
    "**/.all_pdfs/**"
  ],
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.view.pdf.tab.editorGroup": "right",
  "latex-workshop.view.pdf.zoom": "page-width",
  "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",
  "latex-workshop.synctex.afterBuild.enabled": true,
  "files.watcherExclude": {
    "**/.build/**": true,
    "**/.courses/**": true,
    "**/.engine/**": true,
    "**/.all_pdfs/**": true,
    "**/all_datasets/**": true
  },
  "search.exclude": {
    "**/.build/**": true,
    "**/.courses/**": true,
    "**/.engine/**": true,
    "**/.all_pdfs/**": true
  },
  "[latex]": {
    "files.autoSave": "off",
    "editor.wordWrap": "on",
    "editor.formatOnSave": false
  }
}
