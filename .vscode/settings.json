{
  "tinymist.rootPath": "${workspaceFolder}",
  "tinymist.fontPaths": [
    "${workspaceFolder}/.shared/assets/fonts"
  ],
  "tinymist.systemFonts": false,
  "tinymist.exportPdf": "never",
  "tinymist.preview.refresh": "onType",
  "tinymist.preview.invertColors": "never",
  "tinymist.formatterMode": "typstyle",
  "[typst]": {
    "editor.wordWrap": "on",
    "editor.defaultFormatter": "myriad-dreamin.tinymist",
    "editor.formatOnSave": false
  },
  "files.watcherExclude": {
    "**/.build/**": true,
    "**/.courses/**": true,
    "**/.all-pdfs/**": true,
    "**/all_datasets/**": true
  },
  "search.exclude": {
    "**/.build/**": true,
    "**/.courses/**": true,
    "**/.shared/packages/**": true,
    "**/.all-pdfs/**": true
  },
  "typst.preview.autoRefresh": true,
  "typst.compile.debounceMs": 100
}
