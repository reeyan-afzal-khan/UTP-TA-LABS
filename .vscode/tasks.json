{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Typst: build selected course",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/.typst-setup/scripts/build.py",
        "${input:course}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Typst: watch selected course",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/.typst-setup/scripts/build.py",
        "${input:course}",
        "--watch"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Typst: build all courses",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/.typst-setup/scripts/build.py",
        "--all"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Typst: check setup",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/.typst-setup/scripts/build.py",
        "--check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Typst: install compiler",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/.typst-setup/scripts/install.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Subtitles: inventory",
      "type": "process",
      "command": "${workspaceFolder}/.subtitle-setup/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.subtitle-setup/.venv/Scripts/python.exe"
      },
      "args": [
        "-u",
        "${workspaceFolder}/.subtitle-setup/scripts/manage.py",
        "inventory"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Subtitles: transcribe selected course",
      "type": "process",
      "command": "${workspaceFolder}/.subtitle-setup/.venv/bin/python",
      "windows": {
        "command": "python",
        "args": [
          "${workspaceFolder}/.subtitle-setup/scripts/wsl.py",
          "transcribe",
          "--folder",
          "${input:subtitleCourse}"
        ]
      },
      "args": [
        "-u",
        "${workspaceFolder}/.subtitle-setup/scripts/transcribe.py",
        "--folder",
        "${input:subtitleCourse}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Subtitles: show progress",
      "type": "process",
      "command": "${workspaceFolder}/.subtitle-setup/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.subtitle-setup/.venv/Scripts/python.exe"
      },
      "args": [
        "-u",
        "${workspaceFolder}/.subtitle-setup/scripts/manage.py",
        "status"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Subtitles: monitor WSL GPU",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/.subtitle-setup/scripts/wsl.py",
        "monitor"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ],
  "inputs": [
    {
      "id": "course",
      "type": "pickString",
      "description": "Choose the course",
      "options": [
        "0.GIT-REPO-SUBMISSION",
        "ALGORITHMS & DATA STRUCTURES",
        "ARTIFICIAL INTELLIGENCE",
        "DATA COMMUNICATION & NETWORKING",
        "DATA SCIENCE",
        "ENTERPRISE RESOURCE PLANNING",
        "FINTECH INNOVATION",
        "MACHINE LEARNING",
        "OPERATING SYSTEMS"
      ],
      "default": "0.GIT-REPO-SUBMISSION"
    },
    {
      "id": "subtitleCourse",
      "type": "pickString",
      "description": "Choose media under .courses",
      "options": [
        "Data Science",
        "Machine Learning",
        "Odoo Functional Course",
        "SQL",
        "0.GIT-REPO-SUBMISSION.mp3"
      ],
      "default": "SQL"
    }
  ]
}
