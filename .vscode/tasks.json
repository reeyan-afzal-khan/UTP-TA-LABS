{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Typst: build selected course",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/.typst-setup/scripts/build.py",
        "${input:course}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Typst: watch selected course",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/.typst-setup/scripts/build.py",
        "${input:course}",
        "--watch"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Typst: build all courses",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/.typst-setup/scripts/build.py",
        "--all"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Typst: check setup",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/.typst-setup/scripts/build.py",
        "--check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Typst: install compiler",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/.typst-setup/scripts/install.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ],
  "inputs": [
    {
      "id": "course",
      "type": "pickString",
      "description": "Choose the course",
      "options": [
        "0.GIT-REPO-SUBMISSION",
        "ALGORITHMS & DATA STRUCTURES",
        "ARTIFICIAL INTELLIGENCE",
        "DATA COMMUNICATION & NETWORKING",
        "DATA SCIENCE",
        "ENTERPRISE RESOURCE PLANNING",
        "FINTECH INNOVATION",
        "MACHINE LEARNING",
        "OPERATING SYSTEMS"
      ],
      "default": "0.GIT-REPO-SUBMISSION"
    }
  ]
}
