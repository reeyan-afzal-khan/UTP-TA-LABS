{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LaTeX: build selected course",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.latex-setup/Build.ps1",
        "-MainFile",
        "${workspaceFolder}/${input:course}/main.tex"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "LaTeX: check local setup",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.latex-setup/Check.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "LaTeX: build all courses",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.latex-setup/Build-All.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ],
  "inputs": [
    {
      "id": "course",
      "type": "pickString",
      "description": "Choose the course to compile",
      "options": [
        "0.GIT-REPO-SUBMISSION",
        "ALGORITHMS & DATA STRUCTURES",
        "ARTIFICIAL INTELLIGENCE",
        "DATA COMMUNICATION & NETWORKING",
        "DATA SCIENCE",
        "ENTERPRISE RESOURCE PLANNING",
        "FINTECH INNOVATION",
        "MACHINE LEARNING",
        "OPERATING SYSTEMS"
      ],
      "default": "0.GIT-REPO-SUBMISSION"
    }
  ]
}
