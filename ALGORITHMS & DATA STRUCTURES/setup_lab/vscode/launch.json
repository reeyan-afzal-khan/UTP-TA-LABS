// F5 builds the open file (the "C++: build" task in tasks.json) and runs it in the debugger.
// Click left of a line number, or press F9, to set a breakpoint. Then:
//   F10 step over    F11 step into    Shift+F11 step out    F5 continue    Shift+F5 stop
// The setup scripts copy this file from setup_lab/vscode into your project's .vscode folder.
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C++: debug the open file",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}/${fileBasenameNoExtension}",
      "args": [],
      "cwd": "${fileDirname}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "C++: build",
      "setupCommands": [
        {
          "description": "Show strings, vectors and maps readably",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "windows": {
        "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
        "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
        "environment": [
          {
            "name": "PATH",
            "value": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
          }
        ]
      },
      "osx": {
        "MIMode": "lldb"
      }
    }
  ]
}
